# Copy to .env and fill in. Variables already set in your shell take precedence.

# --- Text models (classify / observe / extract / synth) through tools/askllm ---
# Any OpenAI-compatible gateway. ASKLLM_WIRE_API: responses | chat | messages.
# Leave ASKLLM_BASE_URL empty to reuse the gateway from your Codex config (~/.codex/config.toml).
ASKLLM_BASE_URL=https://api.openai.com/v1
ASKLLM_API_KEY=
ASKLLM_WIRE_API=chat

# --- Video understanding through tools/video-understand (Gemini API format) ---
# Official Gemini API works directly: videos are sent inline, no Google Cloud account needed.
PROVIDER_1_BASE_URL=https://generativelanguage.googleapis.com
PROVIDER_1_API_KEY=
PROVIDER_MODELS=gemini-3.8-flash
PROVIDER_TIMEOUT_MS=1800000
# Per-request media cap in MB. Default 14 without GCS (inline). Lower it if a relay rejects large requests.
# PROVIDER_MAX_MEDIA_MB=14
# Optional: upload segments through Google Cloud Storage instead of inline (see tools/video-understand/SETUP.md).
# GCS_BUCKET=
# GCS_PROJECT_ID=
# GCS_KEY_FILENAME=./gcp-service-account.json

# The understanding daemon's port; kept apart from other copies of the tool on this machine.
DAEMON_PORT=43217
DAEMON_MAX_CONCURRENCY=8

# --- Optional paths ---
# BBDOWN_PATH=        BBDown executable (Bilibili downloads and login), default: found on PATH
# YTDLP_PATH=         yt-dlp executable, default: found on PATH
# FORGE_PYTHON=       Python 3.11+ for AskLLM, default: python
# FORGE_SERIF_FONT=   serif font file embedded by `publish`
# BILI_COOKIE=        Bilibili cookie string, instead of the one BBDown login stores
