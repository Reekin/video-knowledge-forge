# Provider
# Configure at least one PROVIDER_n_BASE_URL + PROVIDER_n_API_KEY pair.
# Lower indices have higher priority. The tool tries every provider for the first model, then repeats with the next model.
# Only after every provider/model combination fails does the tool back off and retry the full sequence.
# The official Gemini API (key from https://aistudio.google.com/apikey) is authenticated with
# x-goog-api-key; any other host is treated as a Gemini-compatible gateway and gets a Bearer token.
PROVIDER_1_BASE_URL=https://generativelanguage.googleapis.com
PROVIDER_1_API_KEY=your-gemini-api-key
# PROVIDER_2_BASE_URL=https://your-gateway.example
# PROVIDER_2_API_KEY=your-gateway-api-key

# Default inference parameters
# PROVIDER_MODELS supports an ordered model list separated by commas or new lines; later models are fallbacks.
PROVIDER_MODELS=gemini-3.8-flash
# Legacy single-model fallback is still supported when PROVIDER_MODELS is unset.
# PROVIDER_MODEL=gemini-3.8-flash
PROVIDER_TIMEOUT_MS=900000
# Optional cap on video + audio MB per provider request. Defaults to 14 when media is sent
# inline (fits the ~20MB request limit after base64) and 100 when GCS_BUCKET is set.
# Lower it when a gateway answers long videos with "400 Request contains an invalid argument".
# PROVIDER_MAX_MEDIA_MB=14
PROVIDER_DEFAULT_PROMPT=Understand this video in detail. In the first half of your answer, output a complete sentence-by-sentence transcript with timestamps, preserving the original order of speech as closely as possible. Each transcript entry must include a timestamp range plus the spoken content, and when helpful a brief note about the corresponding visuals. After the transcript section, provide a second half with a structured summary of the key information, topics, people, objects, scene changes, and other notable details.

# Google Cloud Storage (optional)
# Without GCS_BUCKET, each segment's video and audio are sent inline (base64) in the request.
# With it, segments are uploaded and passed by public URL, which suits gateways with small request-body limits.
# GCS_KEY_FILENAME supports relative paths, resolved from the tool directory.
# GCS_OBJECT_PREFIX should be dedicated to this tool because the daemon clears residue objects under this prefix on startup and shutdown.
# GCS_BUCKET=your-bucket-name
# GCS_PROJECT_ID=your-gcp-project-id
# GCS_KEY_FILENAME=./gcp-service-account.json
# GCS_OBJECT_PREFIX=video-understand

# Daemon
DAEMON_HOST=127.0.0.1
DAEMON_PORT=43177
DAEMON_MAX_CONCURRENCY=2
DAEMON_CLEANUP_ON_START=true
DAEMON_CLEANUP_ON_EXIT=true
DAEMON_STARTUP_TIMEOUT_MS=20000
DAEMON_POLL_INTERVAL_MS=1000
DAEMON_TASK_STORE_DIR=./.daemon/tasks
